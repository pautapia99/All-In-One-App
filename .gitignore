# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Lockfile: not committed because `npm install` regenerates slightly
# different content depending on OS (Windows vs. Linux/macOS), which was
# constantly blocking `git pull` with local-changes conflicts. Everyone
# just runs `npm install` locally to get a lockfile that matches their
# own machine.
package-lock.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
