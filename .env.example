# Copia este archivo a ".env" y rellena los valores con las credenciales
# de tu proyecto de Supabase (Project Settings -> API).
#
# Deben empezar por EXPO_PUBLIC_ para que Expo las exponga al cliente
# (app iOS/Android/Web). Nunca pongas aquí la "service_role key".

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
